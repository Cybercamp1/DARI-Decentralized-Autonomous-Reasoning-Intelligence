# DARI Autonomous AI Civilization — Environment Variables

# Required: Gemini API Key (get from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Alchemy API Key for real blockchain monitoring
ALCHEMY_API_KEY=your_alchemy_api_key_here

# Optional: Ethereum RPC URL (defaults to public provider if not set)
ETH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/your_key

# Server port
PORT=5000
